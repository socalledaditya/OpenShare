# ==========================================
# openShare Environment Variables Example
# ==========================================
NODE_ENV= development

# ==========================================
# Frontend Environment Variables (Vercel)
# ==========================================
# Leave empty for single-host deployment (port 3000)
# Set to your Express backend URL when decoupling Vercel UI & backend:
VITE_API_BASE_URL=https://yourapp-backend.onrender.com
VITE_WS_BASE_URL=wss://yourapp-backend.onrender.com/ws
